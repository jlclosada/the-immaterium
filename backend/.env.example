# =============================================================================
#  Ejemplo de archivo .env para el backend
#  Copia este archivo a .env y rellena los valores reales
# =============================================================================

# Django
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# Base de datos PostgreSQL
DB_NAME=warhammer_portal
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_contraseña_postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=disable          # Usar "require" en producción (Neon, etc.)

# Hosts permitidos (separados por coma, sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS – orígenes permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
